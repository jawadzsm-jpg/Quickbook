  "scripts": {
    "dev": "next dev",
    "build": "node scripts/require-ci.mjs && node scripts/migrate.mjs && next build",
    "build:ci": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/release-gates.test.mjs tests/security-validation.test.mjs tests/transaction-context.test.mjs tests/invoice-pricing.test.mjs tests/contact-currency.test.mjs tests/reports.test.mjs tests/document-output.test.mjs tests/backups.test.mjs tests/document-vat.test.mjs tests/layout-engine.test.mjs tests/invoice-cost-fix.test.mjs tests/stock-adjustment.test.mjs tests/report-zero-rows.test.mjs tests/report-currency.test.mjs",
    "ci": "npm run lint && npm test && npm run typecheck && npm run build:ci",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "backup:verify": "node scripts/verify-backup.mjs"
  },
