DATABASE_URL=
NEXT_PUBLIC_APP_URL=https://comnet-enterprise-accounting.vercel.app
# At least 32 random characters. Encrypts the SMTP password / turboSMTP secret and authenticator-app keys at rest.
# Set it in production: without it the key is derived from DATABASE_URL.
SMTP_ENCRYPTION_KEY=
# Optional: server-only token for a PRIVATE Vercel Blob store (Admin Controls backups).
BLOB_READ_WRITE_TOKEN=
